# Notion API Configuration
NOTION_API_KEY=secret_xxxxx
NOTION_NEWS_DB_ID=xxxxx
NOTION_PROJECT_DB_ID=xxxxx
NOTION_SCHEDULE_DB_ID=xxxxx

# Contact & Email Configuration
# All read at runtime — updating them on the host does NOT require a rebuild.
# The contact form works if EITHER email OR the Discord webhook is configured.

# Resend API key. Without it, no email is sent.
RESEND_API_KEY=re_xxxxx
# Where inquiry notifications are delivered (defaults to momoyama.tech@gmail.com).
CONTACT_RECEIVE_EMAIL=momoyama.tech@gmail.com
# Sender address. Keep the resend.dev sandbox address until a domain is
# verified in Resend, then switch to e.g. "Momoyama Tech <noreply@momotech.club>".
MAIL_FROM=Momoyama Tech <onboarding@resend.dev>
# Optional: also post inquiries to a Discord channel.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx

