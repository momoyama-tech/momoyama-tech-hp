# Notion API Configuration
# Read at runtime — set/update on the host without a rebuild.
# Without a valid token the site falls back to built-in sample data
# for News / Projects / Schedule.
# Token: the integration secret (starts with "ntn_" or "secret_").
NOTION_API_KEY=ntn_xxxxx
# Database IDs: the 32-char id from each database's URL.
NOTION_NEWS_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_PROJECT_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NOTION_SCHEDULE_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Contact form
# Runs fully client-side via Web3Forms → momoyama.tech@gmail.com.
# No env var needed; the access key lives in src/lib/contact.js (public by design).

